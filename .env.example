# =============================================================================
# LinkedIn Post Agent - environment template
# =============================================================================
# Copy to .env and fill in. Full instructions: SETUP.md
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Only keys declared in app/core/config.py (Settings) are read. Anything else
# is ignored by pydantic. Keys known to be dead are listed at the bottom with
# the reason, so nobody re-adds them expecting an effect.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
PROJECT_NAME=LinkedIn AI Agent
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# REQUIRED - Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Keep the postgresql+psycopg_async:// prefix - app/db/database.py depends on it.
# Wrap the whole value in double quotes if the password contains $ @ or #.
DATABASE_URL="postgresql+psycopg_async://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# REQUIRED - LLM providers (Gemini primary -> Groq fallback)
# -----------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# REQUIRED - LinkedIn publishing
# -----------------------------------------------------------------------------
# These two ARE the posting identity. See SETUP.md sections 6 and 7.
# Token: LinkedIn Developers -> your app -> Auth -> OAuth 2.0 tools -> Create token
#        scopes: openid profile email w_member_social   (lifetime: 2 months)
# URN:   GET https://api.linkedin.com/v2/userinfo -> take "sub"
#        store as urn:li:person:<sub>  (the prefix is required)
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxxxxxxx

# Publish retry behaviour (app/services/linkedin.py)
LINKEDIN_MAX_RETRIES=3
LINKEDIN_RETRY_BACKOFF=2.0

# -----------------------------------------------------------------------------
# REQUIRED - which users row posts attach to
# -----------------------------------------------------------------------------
# app/api/auth.py looks up users.email = LINKEDIN_USER_EMAIL. That row must
# exist AND have a non-NULL linkedin_access_token, or POST /posts/generate
# fails with a NOT NULL violation on posts.user_id. See SETUP.md section 8.
LINKEDIN_USER_EMAIL=you@example.com
LINKEDIN_USER_NAME=Your Name
LINKEDIN_PROFILE_URL=https://linkedin.com/in/your-vanity-name

# -----------------------------------------------------------------------------
# Supabase - needed only for the browser OAuth login flow
# -----------------------------------------------------------------------------
# Publishing works without these; they power /api/v1/auth/linkedin/login only.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_LINKEDIN_OIDC_PROVIDER=linkedin_oidc

# Must exactly match an entry in the LinkedIn app's Authorized redirect URLs.
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# -----------------------------------------------------------------------------
# LinkedIn app credentials - REFERENCE ONLY
# -----------------------------------------------------------------------------
# Declared in Settings but never read at runtime: the login flow is delegated to
# Supabase GoTrue, which holds its own copy (Supabase Dashboard -> Authentication
# -> Providers -> LinkedIn OIDC). Kept here because you need them to mint the
# access token by hand.
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# Image rendering
# -----------------------------------------------------------------------------
# Must contain Inter_18pt-SemiBold.ttf
FONTS_PATH=assets/fonts/

# Fallback identity, drawn ONLY when the posting URN is not registered below
# and the default blank template is used. Ignored for prebranded templates.
PROFILE_NAME=Your Name
PROFILE_ROLE=Your Role (e.g. Gen AI Engineer)

# -----------------------------------------------------------------------------
# Per-user branding (URN -> template), see app/branding/config.py
# -----------------------------------------------------------------------------
#   CHETAN_PERSON_URN -> assets/branding/linkedin_template.png
#                        blank: renderer draws name, role, badge, thought
#   PRANAV_PERSON_URN -> assets/branding/Pranav_Linkedin_Template.jpeg
#                        prebranded: renderer draws ONLY the thought
#
# Set the one matching LINKEDIN_PERSON_URN to that exact same value. A mismatch
# silently falls back to the blank template and stamps PROFILE_NAME on the image.
# Blank values are skipped at startup with a warning.
CHETAN_PERSON_URN=
PRANAV_PERSON_URN=

# Y coordinate of the thought's first line on the prebranded template.
PRANAV_THOUGHT_TOP_Y=545

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
MAX_CONCURRENT_LLM_CALLS=2

# =============================================================================
# NOT USED - listed so they are not re-added by mistake
# =============================================================================
# OPENAI_API_KEY              no OpenAI call exists; chain is Gemini -> Groq
# OLLAMA_BASE_URL             Ollama was replaced by Groq as the fallback
# OLLAMA_MODEL_NAME           "
# SUPABASE_SERVICE_ROLE_KEY   declared in Settings, referenced nowhere; also the
#                             highest-privilege secret - best left unset
# TEMPLATE_IMAGE_PATH         template paths are hardcoded in branding/config.py
# IMAGE_BRAND_COLOR           never read by the renderer
# LINKEDIN_API_VERSION        hardcoded as the LinkedIn-Version: 202606 header
# LINKEDIN_POSTS_PER_DAY      declared, never referenced
# TOKEN_REFRESH_THRESHOLD_SECONDS / _RETRY_ATTEMPTS / _RETRY_DELAY_MS
#                             declared, never referenced
# CELERY_BROKER_URL           no Celery worker; background work uses FastAPI
# CELERY_RESULT_BACKEND       BackgroundTasks + the Render cron job
# LOG_LEVEL                   not declared in Settings
#
# LANGCHAIN_TRACING_V2 / _ENDPOINT / _API_KEY / _PROJECT
#     Declared in Settings, but the LangSmith SDK reads os.environ and this app
#     never calls load_dotenv() - pydantic-settings does not export to the
#     process environment. Setting them in .env does nothing. To enable tracing,
#     set them as real shell / Render environment variables.
# =============================================================================
